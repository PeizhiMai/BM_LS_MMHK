               "kx", ",", "ky", ",", "\[Mu]", ",", "t", ",", "tp", ",", "U"}],
                "]"}], "//", "N"}], "]"}], "\[Transpose]"}], ",", "First"}], 
          "]"}], "\[Transpose]"}]}], ",", 
