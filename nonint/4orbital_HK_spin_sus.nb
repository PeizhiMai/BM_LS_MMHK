         RowBox[{"{", 
          RowBox[{"i", ",", "bar"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Re", "[", 
       RowBox[{"ParallelSum", "[", 
