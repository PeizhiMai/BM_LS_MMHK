Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinsusceptibiltyqpipipartGS", "[", 
    RowBox[{
    "kx_", ",", "ky_", ",", "\[Mu]_", ",", "t_", ",", "tp_", ",", "U_", ",", 
     "\[Beta]_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tt", "=", 
        RowBox[{
         RowBox[{"SortBy", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Eigensystem", "[", 
             RowBox[{
              RowBox[{"hamiltonianqpipi", "[", 
               RowBox[{
               "kx", ",", "ky", ",", "\[Mu]", ",", "t", ",", "tp", ",", "U", 
                ",", "eta"}], "]"}], "//", "N"}], "]"}], "\[Transpose]"}], 
           ",", "First"}], "]"}], "\[Transpose]"}]}], ",", 
       RowBox[{"bar", "=", "256"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tvals", "=", 
       RowBox[{"tt", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tvecs", "=", 
       RowBox[{"tt", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Z0", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], "*", 
           RowBox[{"tvals", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"tvecs", "[", 
              RowBox[{"[", "n", "]"}], "]"}], "\[ConjugateTranspose]"}], ".", 
            "spipi", ".", 
            RowBox[{"tvecs", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}], "*", 
           RowBox[{"(", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "\[Beta]"}], "*", 
              RowBox[{"tvals", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1"}], "}"}]}], "]"}], "/", "Z0"}], "/", 
       "eta"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spinsusceptibiltyqpipiGS", "[", 
    RowBox[{
    "nn_", ",", "t_", ",", "tp_", ",", "\[Mu]_", ",", "U_", ",", "\[Beta]_"}],
     "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ParallelSum", "[", 
       RowBox[{
        RowBox[{"spinsusceptibiltyqpipipart", "[", 
         RowBox[{
          RowBox[{"n1", "*", 
           RowBox[{"Pi", "/", "nn"}]}], ",", 
          RowBox[{"n2", "*", 
           RowBox[{"Pi", "/", "nn"}]}], ",", "\[Mu]", ",", "t", ",", "tp", 
