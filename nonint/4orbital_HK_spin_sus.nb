      RowBox[{"tvecs", "=", 
       RowBox[{"tt", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Z0", "=", 
       RowBox[{"Sum", "[", 
